//
//  Secrets.example.xcconfig
//  WatchList
//
//  Template. Copy this file to Secrets.xcconfig in the same folder and paste
//  your own keys below. Secrets.xcconfig is git-ignored — never commit it.
//
//      cp Configuration/Secrets.example.xcconfig Configuration/Secrets.xcconfig
//
//  A free TMDb account gives you a v3 API key at:
//  https://www.themoviedb.org/settings/api
//

TMDB_API_KEY =

// Optional: a Trakt client id, for "Open in… Trakt". Without one Trakt just
// isn't offered. Make an API app (free) at https://trakt.tv/oauth/applications/new
// — any name, redirect URI urn:ietf:wg:oauth:2.0:oob — and paste its Client ID.
TRAKT_CLIENT_ID =
